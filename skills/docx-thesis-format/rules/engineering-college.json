  "headings": {
    "chapter": {
      "pattern": "^第[0-9一二三四五六七八九十]+章",
      "font": "仿宋",
      "latinFont": "Times New Roman",
      "fontSizeHalfPoints": 30,
      "bold": true,
      "alignment": "center"
    },
    "section": {
      "pattern": "^([1-9]\\d?\\.\\d{1,2})\\s+(.+)$",
      "spacesAfterNumber": 2,
      "spaceFont": "宋体",
      "font": "仿宋",
      "latinFont": "Times New Roman",
      "fontSizeHalfPoints": 28,
      "bold": true,
      "alignment": "left"
    },
    "subsection": {
      "pattern": "^([1-9]\\d?\\.\\d{1,2}\\.\\d{1,2})\\s+(.+)$",
      "spacesAfterNumber": 1,
      "spaceFont": "宋体",
      "font": "仿宋",
      "latinFont": "Times New Roman",
      "fontSizeHalfPoints": 24,
      "bold": false,
      "alignment": "left"
    }
  },
  "equations": {
    "numberFormat": "（{chapter}-{index}）",
    "appendixNumberFormat": "（{appendix}-{index}）",
    "equationAlignment": "center",
    "numberAlignment": "right",
    "rightTabTwips": 9000
  },
  "figures": {
    "numberFormat": "图{chapter}.{index}",
    "captionPosition": "below",
    "alignment": "center"
  },
  "tables": {
    "numberFormat": "表{chapter}.{index}",
    "captionPosition": "above",
    "alignment": "center",
    "style": "three-line-table",
    "cellAlignment": "left"
  },
  "references": {
    "heading": "参考文献",
    "numberFormat": "[{index}]",
    "continuous": true,
    "orderByCitation": true,
    "typePattern": "\\[(M|C|N|J|D|R|S|P|A|DB|CP|EB/OL|DB/OL)\\]"
  },
  "abstract": {
    "chineseKeywordsMin": 4,
    "chineseKeywordsMax": 8,
    "englishFont": "Times New Roman",
    "fontSizeHalfPoints": 24
  }
